{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Misket",
  "version": "0.1.0",
  "identifier": "io.github.izgebayyurt.misket",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Misket",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Open-source qualitative coding",
    "longDescription": "Misket is a local-first desktop app for qualitative data analysis: import documents, build a codebook, and code excerpts.",
    "fileAssociations": [
      {
        "ext": ["misket"],
        "name": "Misket project",
        "description": "Misket qualitative coding project",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
